<UserControl x:Class="Tyt.Wpf.Views.WeekView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Left"
                        Content="◀"
                        Command="{Binding PreviousWeekCommand}"
                        Width="36"
                        Height="32"
                        Margin="0,0,8,0"/>
                <Button DockPanel.Dock="Right"
                        Content="▶"
                        Command="{Binding NextWeekCommand}"
                        IsEnabled="{Binding CanGoNext}"
                        Width="36"
                        Height="32"
                        Margin="8,0,0,0"/>
                <TextBlock Text="{Binding RangeLabel}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <Border Background="#FEF3C7"
                    Padding="12"
                    CornerRadius="8"
                    Margin="0,0,0,16"
                    Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Tracking is paused. Time is not being recorded."/>
            </Border>

            <UniformGrid Columns="2" Margin="0,0,0,20">
                <Border Background="White" Padding="16" CornerRadius="8" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Active" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding ActiveTotal}" FontSize="28" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Background="White" Padding="16" CornerRadius="8" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Idle" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding IdleTotal}" FontSize="28" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="No activity recorded for this week."
                       Foreground="#6B7280"
                       Margin="0,8,0,16"
                       Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVis}}"/>

            <Border Background="White"
                    Padding="16"
                    CornerRadius="8"
                    Margin="0,0,0,20"
                    Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Active vs idle by day"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Margin="0,0,0,8"/>
                    <lvc:CartesianChart Series="{Binding DailySeries}"
                                        XAxes="{Binding XAxes}"
                                        YAxes="{Binding YAxes}"
                                        LegendPosition="Right"
                                        MinHeight="280"
                                        Height="280"/>
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Top apps this week" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding TopApps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Duration}" Foreground="#6B7280"/>
                                <TextBlock Text="{Binding Name}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
